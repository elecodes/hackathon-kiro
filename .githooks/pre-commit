#!/bin/bash
# Pre-commit hook: Secret Scanner
# Prevents accidental commit of API keys, tokens, passwords, and .env values

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${YELLOW}🔒 Running secret scanner...${NC}"

# Patterns to detect
PATTERNS=(
  'AKIA[0-9A-Z]{16}'                    # AWS Access Key ID
  '[0-9a-zA-Z/+]{40}'                   # AWS Secret Key (40 char base64)
  'sk-[a-zA-Z0-9]{20,}'                 # OpenAI API Key
  'sk-proj-[a-zA-Z0-9_-]{20,}'          # OpenAI Project Key
  'ghp_[a-zA-Z0-9]{36}'                 # GitHub Personal Access Token
  'gho_[a-zA-Z0-9]{36}'                 # GitHub OAuth Token
  'github_pat_[a-zA-Z0-9_]{22,}'        # GitHub Fine-grained PAT
  'xox[baprs]-[a-zA-Z0-9-]+'            # Slack Token
  'sk_live_[a-zA-Z0-9]{24,}'            # Stripe Secret Key
  'pk_live_[a-zA-Z0-9]{24,}'            # Stripe Publishable Key
  'SG\.[a-zA-Z0-9_-]{22}\.[a-zA-Z0-9_-]{43}' # SendGrid API Key
  'eyJ[a-zA-Z0-9_-]*\.eyJ[a-zA-Z0-9_-]*\.[a-zA-Z0-9_-]*' # JWT Token
  'PRIVATE KEY-----'                     # Private keys
  'password\s*[:=]\s*["\x27][^"\x27]+'  # Hardcoded passwords
)

# Files to always block
BLOCKED_FILES=(
  '.env'
  '.env.local'
  '.env.production'
  '.env.development'
)

FOUND_SECRETS=0

# Check for blocked files being committed
for blocked in "${BLOCKED_FILES[@]}"; do
  if git diff --cached --name-only | grep -qE "^${blocked}$"; then
    echo -e "${RED}❌ BLOCKED: ${blocked} should never be committed${NC}"
    echo "   Add it to .gitignore instead."
    FOUND_SECRETS=1
  fi
done

# Check staged file contents for secret patterns
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -vE '\.(png|jpg|jpeg|gif|ico|woff|woff2|ttf|eot|svg)$' || true)

if [ -n "$STAGED_FILES" ]; then
  for pattern in "${PATTERNS[@]}"; do
    MATCHES=$(echo "$STAGED_FILES" | xargs grep -lnE "$pattern" 2>/dev/null || true)
    if [ -n "$MATCHES" ]; then
      echo -e "${RED}❌ Potential secret detected (pattern: ${pattern:0:20}...):${NC}"
      echo "$MATCHES" | while read -r file; do
        echo "   → $file"
      done
      FOUND_SECRETS=1
    fi
  done
fi

# Check for .env files with actual values (not .env.example)
if echo "$STAGED_FILES" | grep -qE '\.env(\.|$)' 2>/dev/null; then
  ENV_FILES=$(echo "$STAGED_FILES" | grep -E '\.env(\.|$)' | grep -v '.example' || true)
  if [ -n "$ENV_FILES" ]; then
    echo -e "${RED}❌ BLOCKED: .env file(s) staged for commit:${NC}"
    echo "$ENV_FILES" | while read -r file; do
      echo "   → $file"
    done
    FOUND_SECRETS=1
  fi
fi

if [ $FOUND_SECRETS -eq 1 ]; then
  echo ""
  echo -e "${RED}🚫 Commit blocked — secrets detected!${NC}"
  echo ""
  echo "Options:"
  echo "  1. Remove the secret from the file"
  echo "  2. Use environment variables instead"
  echo "  3. Add the file to .gitignore"
  echo "  4. Skip this check (NOT recommended): git commit --no-verify"
  echo ""
  exit 1
fi

echo -e "${GREEN}✅ No secrets detected. Proceeding with commit.${NC}"
exit 0
