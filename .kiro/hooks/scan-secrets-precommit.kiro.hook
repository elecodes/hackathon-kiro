{
  "enabled": true,
  "name": "Secret Scanner",
  "description": "Scans staged files before every commit for API keys, tokens, passwords, and .env files with actual values. Blocks the commit if secrets are detected.",
  "version": "1",
  "when": {
    "type": "preToolUse",
    "toolTypes": [
      "write"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Before writing any file, check if the content contains potential secrets: API keys (patterns like sk-*, AKIA*, ghp_*, etc.), passwords, tokens, or .env variable values. If secrets are detected, STOP and warn the user. Never write files containing real credentials."
  }
}